generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(CONTENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id                   String                @id @default(cuid())
  name                 String
  nameEn               String?
  slug                 String                @unique
  skuCode              String?
  isActive             Boolean               @default(true)
  parentId             String?
  description          String?
  seoTitle             String?
  seoDescription       String?
  imageUrl             String?
  sortOrder            Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  parent               Category?             @relation("CategoryTree", fields: [parentId], references: [id])
  children             Category[]            @relation("CategoryTree")
  products             Product[]
  orderItems           OrderItem[]
  patterns             Pattern[]
  measurementTemplates MeasurementTemplate[]
}

model Product {
  id                        String                           @id @default(cuid())
  productCode               String?                          @unique
  systemCode                String?                          @unique
  name                      String
  slug                      String                           @unique
  shortDescription          String?
  description               String?
  seoTitle                  String?
  seoDescription            String?
  aiSummary                 String?
  gsm                       Int?
  material                  String?
  form                      String?
  fit                       String?
  defaultMoq                Int?
  useCases                  String[]
  targetCustomers           String[]
  supportsPrinting          Boolean                          @default(false)
  supportsEmbroidery        Boolean                          @default(false)
  supportsOem               Boolean                          @default(false)
  tags                      String[]
  featuredImage             String?
  gallery                   String[]                         @default([])
  leadTime                  String?
  metadata                  Json?
  categoryId                String
  status                    ProductStatus                    @default(ACTIVE)
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt
  category                  Category                         @relation(fields: [categoryId], references: [id])
  images                    ProductImage[]
  variants                  ProductVariant[]
  crmProductInterests       CRMProductInterest[]
  productPriceTiers         ProductPriceTier[]
  pricingCalcItems          PricingCalculationItem[]
  quoteItems                QuoteItem[]
  orderItems                OrderItem[]
  materialRequirements      ProductMaterialRequirement[]
  options                   ProductOption[]
  specifications            ProductSpecification[]
  customizationCapabilities ProductCustomizationCapability[]
  attributeAssignments      ProductAttributeAssignment[]
  patterns                  Pattern[]
  techPacks                 TechPack[]
  dealerRfqItems            DealerRFQItem[]

  @@index([categoryId])
  @@index([status])
  @@index([systemCode])
}

model Color {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  hex                  String?
  isActive             Boolean               @default(true)
  sortOrder            Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  variants             ProductVariant[]
  orderItems           OrderItem[]
  orderItemVariants    OrderItemVariant[]
  orderProductionFiles OrderProductionFile[]

  @@index([isActive])
  @@index([sortOrder])
}

model Size {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  variants  ProductVariant[]
}

model ProductVariant {
  id                   String                       @id @default(cuid())
  productId            String
  colorId              String?
  sizeId               String?
  sku                  String                       @unique
  colorName            String?
  colorCode            String?
  sizeName             String?
  dimensions           String?
  capacity             String?
  wholesalePrice       Decimal?                     @db.Decimal(12, 2)
  dealerPrice          Decimal?                     @db.Decimal(12, 2)
  vipPrice             Decimal?                     @db.Decimal(12, 2)
  costPrice            Decimal?                     @db.Decimal(12, 2)
  priceTiers           Json?
  stockQty             Int                          @default(0)
  stockStatus          StockStatus                  @default(IN_STOCK)
  imageUrl             String?
  displayLabel         String?
  moqOverride          Int?
  leadTimeOverride     String?
  materialOverride     String?
  weight               Decimal?                     @db.Decimal(8, 3)
  internalNote         String?
  variantStatus        VariantStatus                @default(ACTIVE)
  metadata             Json?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  color                Color?                       @relation(fields: [colorId], references: [id])
  product              Product                      @relation(fields: [productId], references: [id])
  size                 Size?                        @relation(fields: [sizeId], references: [id])
  crmProductInterests  CRMProductInterest[]
  productPriceTiers    ProductPriceTier[]
  pricingCalcItems     PricingCalculationItem[]
  quoteItems           QuoteItem[]
  orderItems           OrderItem[]
  materialRequirements ProductMaterialRequirement[]
  optionValues         ProductVariantOptionValue[]
  techPacks            TechPack[]
  dealerRfqItems       DealerRFQItem[]

  @@index([productId])
  @@index([stockStatus])
  @@index([variantStatus])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  imageUrl  String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
}

model ProductOption {
  id          String               @id @default(cuid())
  productId   String
  attributeId String?
  name        String
  slug        String
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  product     Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   ProductAttribute?    @relation(fields: [attributeId], references: [id], onDelete: SetNull)
  values      ProductOptionValue[]

  @@unique([productId, slug])
  @@index([attributeId])
  @@index([productId, sortOrder])
}

model ProductOptionValue {
  id               String                      @id @default(cuid())
  optionId         String
  attributeValueId String?
  label            String
  valueCode        String?
  imageUrl         String?
  sortOrder        Int                         @default(0)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  option           ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  attributeValue   ProductAttributeValue?      @relation(fields: [attributeValueId], references: [id], onDelete: SetNull)
  variants         ProductVariantOptionValue[]

  @@index([attributeValueId])
  @@index([optionId, sortOrder])
}

model ProductVariantOptionValue {
  variantId     String
  optionValueId String
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

model ProductSpecification {
  id        String   @id @default(cuid())
  productId String
  label     String
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductCustomizationCapability {
  id          String   @id @default(cuid())
  productId   String
  label       String
  description String?
  sortOrder   Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Lead {
  id                  String               @id @default(cuid())
  code                String?              @unique
  fullName            String
  phone               String
  email               String?
  company             String?
  contactName         String?
  companyName         String?
  zalo                String?
  source              LeadSource           @default(WEBSITE)
  sourceDetail        String?
  demand              String?              @db.Text
  status              LeadStatus           @default(NEW)
  priority            LeadPriority         @default(NORMAL)
  message             String?              @db.Text
  note                String?              @db.Text
  followUpAt          DateTime?
  nextFollowUpAt      DateTime?
  estimatedValue      Decimal?             @db.Decimal(12, 2)
  assignedTo          String?
  customerId          String?
  contactId           String?
  convertedAt         DateTime?
  landingPage         String?
  utmSource           String?
  utmMedium           String?
  utmCampaign         String?
  referrer            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contact             Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  notes               LeadNote[]
  activities          CRMActivity[]
  productInterests    CRMProductInterest[]
  pricingCalculations PricingCalculation[]
  quotes              Quote[]
  salesOpportunities    SalesOpportunity[]
  dealerRfq           DealerRFQ?

  @@index([code])
  @@index([status])
  @@index([source])
  @@index([priority])
  @@index([phone])
  @@index([email])
  @@index([customerId])
  @@index([createdAt])
  @@index([followUpAt])
  @@index([nextFollowUpAt])
}

model AdministrativeProvince {
  id        String               @id @default(cuid())
  code      String               @unique
  name      String
  sortOrder Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  wards     AdministrativeWard[]
  customers Customer[]

  @@index([code])
  @@index([name])
}

model AdministrativeWard {
  id         String                 @id @default(cuid())
  code       String                 @unique
  provinceId String
  name       String
  sortOrder  Int                    @default(0)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  province   AdministrativeProvince @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  customers  Customer[]

  @@index([provinceId])
  @@index([code])
  @@index([name])
}

model Customer {
  id                        String                           @id @default(cuid())
  code                      String                           @unique
  legacyType                CustomerLegacyType               @default(BUSINESS) @map("type")
  customerTypeId            String?
  name                      String
  legalName                 String?
  taxCode                   String?
  phone                     String?
  email                     String?
  website                   String?
  address                   String?
  province                  String?
  district                  String?
  provinceId                String?
  wardId                    String?
  provinceNameSnapshot      String?
  wardNameSnapshot          String?
  addressLine1              String?
  addressLine2              String?
  representativeName        String?
  representativeSalutation  CustomerRepresentativeSalutation?
  representativeTitle       String?
  authorizationDocumentNo   String?
  status                    CustomerStatus                   @default(PROSPECT)
  note                      String?                          @db.Text
  internalNote              String?                          @db.Text
  billingNote               String?                          @db.Text
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt
  provinceRef               AdministrativeProvince?          @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  wardRef                   AdministrativeWard?              @relation(fields: [wardId], references: [id], onDelete: SetNull)
  customerType              CustomerType?                    @relation(fields: [customerTypeId], references: [id], onDelete: SetNull)
  contacts                  Contact[]
  leads                     Lead[]
  activities                CRMActivity[]
  productInterests          CRMProductInterest[]
  pricingCalculations       PricingCalculation[]
  quotes                    Quote[]
  orders                    Order[]
  techPacks                 TechPack[]
  dealerCompanies           DealerCompany[]
  dealerRfqs                DealerRFQ[]
  salesOpportunities        SalesOpportunity[]
  patterns                  Pattern[]

  @@index([code])
  @@index([name])
  @@index([phone])
  @@index([email])
  @@index([legacyType])
  @@index([customerTypeId])
  @@index([status])
  @@index([provinceId])
  @@index([wardId])
}

model CustomerType {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  isSystem    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  customers   Customer[]

  @@index([isActive, sortOrder])
}

model Contact {
  id                  String               @id @default(cuid())
  customerId          String
  fullName            String
  title               String?
  department          String?
  phone               String?
  email               String?
  zalo                String?
  isPrimary           Boolean              @default(false)
  note                String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leads               Lead[]
  activities          CRMActivity[]
  pricingCalculations PricingCalculation[]
  quotes              Quote[]
  orders              Order[]
  salesOpportunities  SalesOpportunity[]

  @@index([customerId])
}

model CRMActivity {
  id             String          @id @default(cuid())
  leadId         String?
  customerId     String?
  contactId      String?
  type           CRMActivityType @default(NOTE)
  title          String
  content        String?         @db.Text
  outcome        String?
  nextFollowUpAt DateTime?
  createdBy      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact        Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([customerId])
  @@index([createdAt])
}

model CRMProductInterest {
  id                  String          @id @default(cuid())
  leadId              String?
  customerId          String?
  productId           String?
  variantId           String?
  productNameSnapshot String?
  quantity            Int?
  unit                String?         @default("cái")
  requirementNote     String?         @db.Text
  serviceNeeds        Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  lead                Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer            Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product             Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([customerId])
  @@index([productId])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model Dealer {
  id          String       @id @default(cuid())
  companyName String
  taxCode     String?
  phone       String
  email       String
  city        String?
  website     String?
  facebook    String?
  status      DealerStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model DealerLead {
  id             String             @id @default(cuid())
  companyName    String?
  contactName    String
  phone          String
  email          String?
  city           String?
  source         String
  message        String?
  status         DealerLeadStatus   @default(NEW)
  // Attribution
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  referrer       String?
  landingPage    String?
  // CRM pipeline
  pipelineStatus LeadPipelineStatus @default(NEW)
  assignedTo     String?
  estimatedValue Decimal?           @db.Decimal(12, 2)
  contactedAt    DateTime?
  wonAt          DateTime?
  lostAt         DateTime?
  salesNote      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

enum DealerCompanyType {
  DEALER
  AGENCY
  PRINTING_COMPANY
  EVENT_COMPANY
  CORPORATE_BUYER
  OEM_CLIENT
  OTHER
}

enum DealerCompanyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum DealerLevel {
  STANDARD
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum DealerUserRole {
  OWNER
  MANAGER
  SALES
  PURCHASING
  VIEWER
}

enum DealerUserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum DealerActivityType {
  CREATED
  UPDATED
  APPROVED
  REJECTED
  USER_ADDED
  CRM_LINKED
  PRICE_GROUP_ASSIGNED
  NOTE_ADDED
  LOGIN
}

model DealerCompany {
  id              String              @id @default(cuid())
  code            String              @unique
  name            String
  legalName       String?
  taxCode         String?
  email           String?
  phone           String?
  website         String?
  address         String?
  city            String?
  country         String              @default("Vietnam")
  type            DealerCompanyType   @default(DEALER)
  status          DealerCompanyStatus @default(PENDING)
  level           DealerLevel         @default(STANDARD)
  customerId      String?
  priceGroupId    String?
  approvedAt      DateTime?
  approvedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?
  notes           String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  customer        Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  priceGroup      PriceGroup?         @relation(fields: [priceGroupId], references: [id], onDelete: SetNull)
  users           DealerUser[]
  activities      DealerActivity[]
  rfqs            DealerRFQ[]

  @@index([status])
  @@index([type])
  @@index([level])
  @@index([customerId])
  @@index([priceGroupId])
  @@index([code])
  @@index([name])
}

model DealerUser {
  id                  String           @id @default(cuid())
  dealerCompanyId     String
  name                String
  email               String           @unique
  phone               String?
  role                DealerUserRole   @default(VIEWER)
  status              DealerUserStatus @default(INVITED)
  passwordHash        String?
  passwordSetAt       DateTime?
  invitedAt           DateTime?
  loginDisabledReason String?
  lastLoginAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  dealerCompany       DealerCompany    @relation(fields: [dealerCompanyId], references: [id], onDelete: Cascade)
  activities          DealerActivity[]
  rfqs                DealerRFQ[]

  @@index([dealerCompanyId])
  @@index([status])
}

model DealerActivity {
  id              String             @id @default(cuid())
  dealerCompanyId String
  dealerUserId    String?
  type            DealerActivityType
  title           String
  description     String?
  metadata        Json?
  createdAt       DateTime           @default(now())
  dealerCompany   DealerCompany      @relation(fields: [dealerCompanyId], references: [id], onDelete: Cascade)
  dealerUser      DealerUser?        @relation(fields: [dealerUserId], references: [id], onDelete: SetNull)

  @@index([dealerCompanyId, createdAt])
}

enum DealerRFQProjectType {
  BLANK_APPAREL
  UNIFORM
  CORPORATE_GIFT
  EVENT_MERCH
  OEM_PRIVATE_LABEL
  PRINT_SERVICE
  SAMPLE
  OTHER
}

enum DealerRFQStatus {
  DRAFT
  SUBMITTED
  REVIEWING
  NEED_MORE_INFO
  PRICING
  QUOTED
  WON
  LOST
  CANCELLED
}

enum DealerRFQPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DealerRFQArtworkStatus {
  NOT_PROVIDED
  PROVIDED
  NEED_REVIEW
  APPROVED
  REVISION_REQUIRED
}

model DealerRFQ {
  id                    String                 @id @default(cuid())
  code                  String                 @unique
  dealerCompanyId       String
  dealerUserId          String?
  customerId            String?
  leadId                String?                @unique
  quoteId               String?                @unique
  pricingCalculationId  String?
  title                 String
  projectType           DealerRFQProjectType   @default(OTHER)
  status                DealerRFQStatus        @default(DRAFT)
  priority              DealerRFQPriority      @default(NORMAL)
  contactName           String?
  contactEmail          String?
  contactPhone          String?
  companyName           String?
  productSummary        String?                @db.Text
  quantity              Int?
  targetBudget          Decimal?               @db.Decimal(12, 2)
  deadline              DateTime?
  deliveryLocation      String?
  artworkStatus         DealerRFQArtworkStatus @default(NOT_PROVIDED)
  artworkUrls           Json?
  note                  String?                @db.Text
  internalNote          String?                @db.Text
  assignedToAdminUserId String?
  submittedAt           DateTime?
  quotedAt              DateTime?
  closedAt              DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  dealerCompany         DealerCompany          @relation(fields: [dealerCompanyId], references: [id], onDelete: Cascade)
  dealerUser            DealerUser?            @relation(fields: [dealerUserId], references: [id], onDelete: SetNull)
  customer              Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead                  Lead?                  @relation(fields: [leadId], references: [id], onDelete: SetNull)
  quote                 Quote?                 @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  pricingCalculation    PricingCalculation?    @relation(fields: [pricingCalculationId], references: [id], onDelete: SetNull)
  assignedToAdminUser   AdminUser?             @relation(fields: [assignedToAdminUserId], references: [id], onDelete: SetNull)
  items                 DealerRFQItem[]

  @@index([dealerCompanyId])
  @@index([status])
  @@index([priority])
  @@index([assignedToAdminUserId])
  @@index([createdAt])
  @@index([deadline])
}

model DealerRFQItem {
  id             String          @id @default(cuid())
  rfqId          String
  productId      String?
  variantId      String?
  productName    String
  variantName    String?
  skuSnapshot    String?
  colorSnapshot  String?
  quantity       Int
  decorationType String?
  position       String?
  note           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  rfq            DealerRFQ       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([rfqId])
  @@index([productId])
  @@index([variantId])
}

model Post {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  excerpt        String?
  content        String?
  imageUrl       String?
  status         PostStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model BlogCategory {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  description String?
  isVisible   Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  posts       BlogPostCategory[]
}

model BlogPost {
  id               String             @id @default(cuid())
  title            String
  slug             String             @unique
  excerpt          String?
  content          String?            @db.Text
  featuredImageUrl String?
  metaTitle        String?
  metaDescription  String?
  canonicalUrl     String?
  ogImageUrl       String?
  status           BlogPostStatus     @default(DRAFT)
  publishedAt      DateTime?
  faqJson          Json               @default("[]")
  tags             Json               @default("[]")
  aiMetadata       Json?
  /// Optional curated Media Bundle used as content-media source (explicit assignments are snapshots).
  mediaBundleId    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  categories       BlogPostCategory[]
  mediaBundle      MediaBundle?       @relation(fields: [mediaBundleId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([publishedAt])
  @@index([createdAt])
  @@index([mediaBundleId])
}

model BlogPostCategory {
  postId     String
  categoryId String
  post       BlogPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// SEO Content Platform (Sprint 11.0) — strategy / topics / briefs (no AI writer)
// ---------------------------------------------------------------------------

enum SeoStrategyStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum SeoTopicStatus {
  IDEA
  RESEARCHING
  APPROVED
  BRIEF_READY
  DRAFTING
  REVIEW
  PUBLISHED
  PAUSED
  REJECTED
  ARCHIVED
}

enum SeoSearchIntent {
  INFORMATIONAL
  COMMERCIAL
  TRANSACTIONAL
  NAVIGATIONAL
  LOCAL
  MIXED
}

enum SeoContentType {
  BLOG_ARTICLE
  LANDING_PAGE
  CATEGORY_PAGE
  PRODUCT_GUIDE

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(CONTENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  skuCode        String?
  parentId       String?
  description    String?
  seoTitle       String?
  seoDescription String?
  imageUrl       String?
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryTree")
  products       Product[]
}

model Product {
  id                  String                   @id @default(cuid())
  productCode         String?                  @unique
  name                String
  slug                String                   @unique
  shortDescription    String?
  description         String?
  seoTitle            String?
  seoDescription      String?
  aiSummary           String?
  gsm                 Int?
  material            String?
  form                String?
  fit                 String?
  defaultMoq          Int?
  useCases            String[]
  targetCustomers     String[]
  supportsPrinting    Boolean                  @default(false)
  supportsEmbroidery  Boolean                  @default(false)
  supportsOem         Boolean                  @default(false)
  tags                String[]
  featuredImage       String?
  gallery             String[]                 @default([])
  leadTime            String?
  metadata            Json?
  categoryId          String
  status              ProductStatus            @default(ACTIVE)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  category            Category                 @relation(fields: [categoryId], references: [id])
  images              ProductImage[]
  variants            ProductVariant[]
  crmProductInterests CRMProductInterest[]
  productPriceTiers   ProductPriceTier[]
  pricingCalcItems    PricingCalculationItem[]
  quoteItems          QuoteItem[]

  @@index([categoryId])
  @@index([status])
}

model Color {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  variants  ProductVariant[]
}

model Size {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  variants  ProductVariant[]
}

model ProductVariant {
  id                  String                   @id @default(cuid())
  productId           String
  colorId             String?
  sizeId              String?
  sku                 String                   @unique
  colorName           String?
  colorCode           String?
  sizeName            String?
  dimensions          String?
  capacity            String?
  wholesalePrice      Decimal?                 @db.Decimal(12, 2)
  dealerPrice         Decimal?                 @db.Decimal(12, 2)
  vipPrice            Decimal?                 @db.Decimal(12, 2)
  costPrice           Decimal?                 @db.Decimal(12, 2)
  priceTiers          Json?
  stockQty            Int                      @default(0)
  stockStatus         StockStatus              @default(IN_STOCK)
  imageUrl            String?
  weight              Decimal?                 @db.Decimal(8, 3)
  internalNote        String?
  variantStatus       VariantStatus            @default(ACTIVE)
  metadata            Json?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  color               Color?                   @relation(fields: [colorId], references: [id])
  product             Product                  @relation(fields: [productId], references: [id])
  size                Size?                    @relation(fields: [sizeId], references: [id])
  crmProductInterests CRMProductInterest[]
  productPriceTiers   ProductPriceTier[]
  pricingCalcItems    PricingCalculationItem[]
  quoteItems          QuoteItem[]

  @@index([productId])
  @@index([stockStatus])
  @@index([variantStatus])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  imageUrl  String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
}

model Lead {
  id                  String               @id @default(cuid())
  code                String?              @unique
  fullName            String
  phone               String
  email               String?
  company             String?
  contactName         String?
  companyName         String?
  zalo                String?
  source              LeadSource           @default(WEBSITE)
  sourceDetail        String?
  demand              String?              @db.Text
  status              LeadStatus           @default(NEW)
  priority            LeadPriority         @default(NORMAL)
  message             String?              @db.Text
  note                String?              @db.Text
  followUpAt          DateTime?
  nextFollowUpAt      DateTime?
  estimatedValue      Decimal?             @db.Decimal(12, 2)
  assignedTo          String?
  customerId          String?
  contactId           String?
  convertedAt         DateTime?
  landingPage         String?
  utmSource           String?
  utmMedium           String?
  utmCampaign         String?
  referrer            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contact             Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  notes               LeadNote[]
  activities          CRMActivity[]
  productInterests    CRMProductInterest[]
  pricingCalculations PricingCalculation[]
  quotes              Quote[]

  @@index([code])
  @@index([status])
  @@index([source])
  @@index([priority])
  @@index([phone])
  @@index([email])
  @@index([customerId])
  @@index([createdAt])
  @@index([followUpAt])
  @@index([nextFollowUpAt])
}

model Customer {
  id                  String               @id @default(cuid())
  code                String               @unique
  type                CustomerType         @default(BUSINESS)
  name                String
  legalName           String?
  taxCode             String?
  phone               String?
  email               String?
  website             String?
  address             String?
  province            String?
  district            String?
  status              CustomerStatus       @default(PROSPECT)
  note                String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  contacts            Contact[]
  leads               Lead[]
  activities          CRMActivity[]
  productInterests    CRMProductInterest[]
  pricingCalculations PricingCalculation[]
  quotes              Quote[]

  @@index([code])
  @@index([name])
  @@index([phone])
  @@index([email])
  @@index([type])
  @@index([status])
}

model Contact {
  id                  String               @id @default(cuid())
  customerId          String
  fullName            String
  title               String?
  phone               String?
  email               String?
  zalo                String?
  isPrimary           Boolean              @default(false)
  note                String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leads               Lead[]
  activities          CRMActivity[]
  pricingCalculations PricingCalculation[]
  quotes              Quote[]

  @@index([customerId])
}

model CRMActivity {
  id             String          @id @default(cuid())
  leadId         String?
  customerId     String?
  contactId      String?
  type           CRMActivityType @default(NOTE)
  title          String
  content        String?         @db.Text
  outcome        String?
  nextFollowUpAt DateTime?
  createdBy      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact        Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([customerId])
  @@index([createdAt])
}

model CRMProductInterest {
  id                  String          @id @default(cuid())
  leadId              String?
  customerId          String?
  productId           String?
  variantId           String?
  productNameSnapshot String?
  quantity            Int?
  unit                String?         @default("cái")
  requirementNote     String?         @db.Text
  serviceNeeds        Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  lead                Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer            Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product             Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([customerId])
  @@index([productId])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model Dealer {
  id          String       @id @default(cuid())
  companyName String
  taxCode     String?
  phone       String
  email       String
  city        String?
  website     String?
  facebook    String?
  status      DealerStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model DealerLead {
  id             String             @id @default(cuid())
  companyName    String?
  contactName    String
  phone          String
  email          String?
  city           String?
  source         String
  message        String?
  status         DealerLeadStatus   @default(NEW)
  // Attribution
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  referrer       String?
  landingPage    String?
  // CRM pipeline
  pipelineStatus LeadPipelineStatus @default(NEW)
  assignedTo     String?
  estimatedValue Decimal?           @db.Decimal(12, 2)
  contactedAt    DateTime?
  wonAt          DateTime?
  lostAt         DateTime?
  salesNote      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model Post {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  excerpt        String?
  content        String?
  imageUrl       String?
  status         PostStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model BlogCategory {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  description String?
  isVisible   Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  posts       BlogPostCategory[]
}

model BlogPost {
  id               String             @id @default(cuid())
  title            String
  slug             String             @unique
  excerpt          String?
  content          String?            @db.Text
  featuredImageUrl String?
  metaTitle        String?
  metaDescription  String?
  canonicalUrl     String?
  ogImageUrl       String?
  status           BlogPostStatus     @default(DRAFT)
  publishedAt      DateTime?
  faqJson          Json               @default("[]")
  tags             Json               @default("[]")
  aiMetadata       Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  categories       BlogPostCategory[]

  @@index([status])
  @@index([publishedAt])
  @@index([createdAt])
}

model BlogPostCategory {
  postId     String
  categoryId String
  post       BlogPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
}

enum MediaFolder {
  PRODUCTS
  CATEGORIES
  CLIENTS
  CASE_STUDIES
  BRANDING
  BLOG
  GENERAL
}

enum MediaUsageType {
  PRODUCT
  BLOG
  KNOWLEDGE_BASE
  GENERAL
}

model MediaAsset {
  id           String         @id @default(cuid())
  filename     String
  originalName String?
  url          String
  thumbnailUrl String?
  storageKey   String
  publicId     String?
  mimeType     String
  format       String?
  sizeBytes    Int
  width        Int?
  height       Int?
  folder       MediaFolder
  usageType    MediaUsageType @default(GENERAL)
  altText      String?
  title        String?
  tags         String[]       @default([])
  uploadedBy   String?
  metadata     Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([folder])
  @@index([filename])
  @@index([usageType])
}

model ClientLogoRecord {
  id          String   @id @default(cuid())
  companyName String
  website     String?
  imageUrl    String
  isVisible   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CaseStudyRecord {
  id        String   @id @default(cuid())
  title     String
  category  String
  quantity  String
  timeline  String
  summary   String
  imageUrl  String
  isVisible Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanySettings {
  id             String   @id @default("default")
  brandName      String   @default("ATTD")
  legalName      String   @default("")
  tagline        String   @default("")
  hotlineRaw     String   @default("")
  hotlineDisplay String   @default("")
  zaloPhone      String   @default("")
  zaloUrl        String   @default("")
  email          String   @default("")
  address        String   @default("")
  taxCode        String   @default("")
  workingHours   String   @default("")
  updatedAt      DateTime @updatedAt
}

model TrustMetricsSettings {
  id              String   @id @default("default")
  clientsCount    Int?
  partnerCount    Int?
  provinceCount   Int?
  experienceYears Int?
  sectionTitle    String   @default("Tại sao đại lý và doanh nghiệp chọn ATTD?")
  updatedAt       DateTime @updatedAt
}

model BrandingSettings {
  id                String   @id @default("default")
  headerLogoUrl     String?
  footerLogoUrl     String?
  faviconUrl        String?
  defaultOgImageUrl String?
  companyTagline    String   @default("")
  facebookUrl       String?
  zaloUrl           String?
  youtubeUrl        String?
  tiktokUrl         String?
  linkedinUrl       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model LandingPageContent {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  metaTitle         String   @default("")
  metaDescription   String   @default("")
  heroTitle         String   @default("")
  heroDescription   String   @default("")
  seoContent        String   @default("") @db.Text
  faqJson           Json     @default("[]")
  primaryCtaLabel   String   @default("")
  primaryCtaHref    String   @default("")
  secondaryCtaLabel String   @default("")
  secondaryCtaHref  String   @default("")
  isPublished       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum PostStatus {
  PUBLISHED
  DRAFT
}

enum BlogPostStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SALES
  CONTENT
  WAREHOUSE
}

enum ProductStatus {
  ACTIVE
  DRAFT
  INACTIVE
  ARCHIVED
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  PREORDER
}

enum VariantStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum LeadSource {
  CONTACT
  DEALER
  OEM
  SOURCING
  LANDING_PAGE
  WEBSITE
  ZALO
  FACEBOOK
  PHONE
  REFERRAL
  OLD_CUSTOMER
  DIRECT
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTING
  QUALIFIED
  NEED_PRICING
  QUOTED
  NEGOTIATING
  WON
  LOST
  NOT_FIT
}

enum LeadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CustomerType {
  DEALER
  AGENCY
  PRINTER
  EVENT_COMPANY
  BUSINESS
  RETAIL
  SUPPLIER
  OTHER
}

enum CustomerStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  VIP
  BLACKLISTED
}

enum CRMActivityType {
  CALL
  ZALO
  EMAIL
  MEETING
  NOTE
  FOLLOW_UP
  QUOTE_REQUEST
  SAMPLE_REQUEST
  STATUS_CHANGE
}

enum DealerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DealerLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

enum LeadPipelineStatus {
  NEW
  CONTACTED
  QUOTED
  NEGOTIATING
  WON
  LOST
}

// ── Sprint 24.8 — Business Knowledge Base ───────────────────────────────────

enum KnowledgeBaseEntryType {
  COMPANY
  PRODUCT
  MATERIAL
  MANUFACTURING
  OEM
  WHOLESALE
  DEALER
  PRICING
  POLICY
  CASE_STUDY
  FAQ
  SALES_SCRIPT
  SEO_CONTEXT
  BRAND_VOICE
  LOGISTICS
  QUALITY_CONTROL
  CUSTOMER_SEGMENT
  COMPETITOR_NOTE
}

enum KnowledgeBaseEntryStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum KnowledgeBasePriority {
  HIGH
  MEDIUM
  LOW
}

enum KnowledgeBaseSourceType {
  INTERNAL
  WEBSITE
  DOCUMENT
  STAFF_NOTE
  CUSTOMER_FEEDBACK
  MANUAL_INPUT
}

enum ProductAttributeType {
  COLOR
  SIZE
  MATERIAL
  FORM
  FIT
  DIMENSION
  CAPACITY
  UNIT
}

enum ProductAttributeStatus {
  ACTIVE
  INACTIVE
}

model ProductAttributeOption {
  id        String                 @id @default(cuid())
  type      ProductAttributeType
  name      String
  code      String?
  value     String?
  metadata  Json?
  sortOrder Int                    @default(0)
  status    ProductAttributeStatus @default(ACTIVE)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([type, name])
  @@index([type])
  @@index([status])
}

enum ProductImportJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
  UPLOADED
  PREVIEWED
  VALIDATED
  COMPLETED
  PARTIAL
}

model ProductImportJob {
  id                String                 @id @default(cuid())
  fileName          String
  fileType          String?
  fileSize          Int?
  uploadedBy        String?
  preset            String?
  duplicateStrategy String?
  status            ProductImportJobStatus @default(PENDING)
  totalRows         Int                    @default(0)
  validRows         Int                    @default(0)
  createdProducts   Int                    @default(0)
  updatedProducts   Int                    @default(0)
  createdVariants   Int                    @default(0)
  updatedVariants   Int                    @default(0)
  skippedRows       Int                    @default(0)
  invalidRows       Int                    @default(0)
  duplicateRows     Int                    @default(0)
  createdCategories Int                    @default(0)
  errorCount        Int                    @default(0)
  warningCount      Int                    @default(0)
  originalFileUrl   String?
  originalFileKey   String?
  feedbackFileUrl   String?
  feedbackFileKey   String?
  errors            Json?
  metadata          Json?
  summaryJson       Json?
  errorsJson        Json?
  warningsJson      Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([createdAt])
  @@index([status])
}

model KnowledgeBaseCategory {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  description String?
  sortOrder   Int                  @default(0)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  entries     KnowledgeBaseEntry[]

  @@index([sortOrder])
}

model KnowledgeBaseSource {
  id        String                  @id @default(cuid())
  name      String
  type      KnowledgeBaseSourceType
  url       String?
  note      String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  entries   KnowledgeBaseEntry[]
}

model KnowledgeBaseEntry {
  id                      String                   @id @default(cuid())
  title                   String
  slug                    String                   @unique
  summary                 String?
  content                 String?                  @db.Text
  structuredData          Json?
  categoryId              String
  category                KnowledgeBaseCategory    @relation(fields: [categoryId], references: [id])
  type                    KnowledgeBaseEntryType
  status                  KnowledgeBaseEntryStatus @default(DRAFT)
  priority                KnowledgeBasePriority    @default(MEDIUM)
  sourceId                String?
  source                  KnowledgeBaseSource?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  tags                    String[]                 @default([])
  relatedProductIds       String[]                 @default([])
  relatedLandingPageSlugs String[]                 @default([])
  relatedBlogPostIds      String[]                 @default([])
  usageScope              String[]                 @default([])
  isFeatured              Boolean                  @default(false)
  isVerified              Boolean                  @default(false)
  verifiedAt              DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  usageLogs               KnowledgeBaseUsageLog[]

  @@index([categoryId])
  @@index([type])
  @@index([status])
  @@index([priority])
  @@index([isVerified])
}

model KnowledgeBaseUsageLog {
  id         String             @id @default(cuid())
  entryId    String
  entry      KnowledgeBaseEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  usedFor    String
  targetType String
  targetId   String?
  createdAt  DateTime           @default(now())

  @@index([entryId])
  @@index([createdAt])
}

enum KnowledgeBaseImportJobStatus {
  PENDING
  COMPLETED
  FAILED
  PARTIAL
}

model KnowledgeBaseImportJob {
  id            String                       @id @default(cuid())
  fileName      String                       @map("filename")
  fileType      String                       @default("csv")
  totalRows     Int                          @default(0) @map("rows")
  validRows     Int                          @default(0)
  invalidRows   Int                          @default(0)
  createdRows   Int                          @default(0) @map("imported")
  updatedRows   Int                          @default(0)
  skippedRows   Int                          @default(0) @map("skipped")
  duplicateRows Int                          @default(0)
  status        KnowledgeBaseImportJobStatus @default(PENDING)
  errorMessage  String?
  errors        Json                         @default("[]")
  metadata      Json?
  createdBy     String?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @default(now()) @updatedAt

  @@index([createdAt])
}

// ── Sprint 26.1.0 — Pricing Engine Foundation ─────────────────────────────────

enum PricingCalculationStatus {
  DRAFT
  CALCULATED
  USED_FOR_QUOTE
  ARCHIVED
}

enum PricingServiceType {
  PRINT_DTF
  PRINT_SILK
  EMBROIDERY
  OEM
  PACKAGING
  DESIGN
  SETUP
  SHIPPING
  OTHER
}

enum PricingCalculationType {
  PER_ITEM
  PER_ORDER
  PER_POSITION
  MANUAL
}

model PriceGroup {
  id                  String               @id @default(cuid())
  code                String               @unique
  name                String
  description         String?
  isDefault           Boolean              @default(false)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  productPriceTiers   ProductPriceTier[]
  servicePriceRules   ServicePriceRule[]
  pricingCalculations PricingCalculation[]
  quotes              Quote[]

  @@index([code])
  @@index([isActive])
  @@index([isDefault])
}

model ProductPriceTier {
  id            String          @id @default(cuid())
  productId     String
  variantId     String?
  priceGroupId  String
  minQuantity   Int
  maxQuantity   Int?
  unitPrice     Decimal         @db.Decimal(12, 2)
  costPrice     Decimal?        @db.Decimal(12, 2)
  currency      String          @default("VND")
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  isActive      Boolean         @default(true)
  note          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  priceGroup    PriceGroup      @relation(fields: [priceGroupId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@index([priceGroupId])
  @@index([minQuantity])
  @@index([isActive])
}

model ServicePriceRule {
  id              String                 @id @default(cuid())
  serviceType     PricingServiceType
  name            String
  priceGroupId    String?
  minQuantity     Int                    @default(1)
  maxQuantity     Int?
  calculationType PricingCalculationType @default(PER_ITEM)
  unitPrice       Decimal                @default(0) @db.Decimal(12, 2)
  setupFee        Decimal                @default(0) @db.Decimal(12, 2)
  currency        String                 @default("VND")
  isActive        Boolean                @default(true)
  note            String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  priceGroup      PriceGroup?            @relation(fields: [priceGroupId], references: [id], onDelete: SetNull)

  @@index([serviceType])
  @@index([priceGroupId])
  @@index([isActive])
}

model PricingCalculation {
  id                   String                   @id @default(cuid())
  code                 String                   @unique
  leadId               String?
  customerId           String?
  contactId            String?
  priceGroupId         String?
  status               PricingCalculationStatus @default(CALCULATED)
  subtotal             Decimal                  @default(0) @db.Decimal(12, 2)
  serviceTotal         Decimal                  @default(0) @db.Decimal(12, 2)
  setupTotal           Decimal                  @default(0) @db.Decimal(12, 2)
  discountAmount       Decimal                  @default(0) @db.Decimal(12, 2)
  shippingFee          Decimal                  @default(0) @db.Decimal(12, 2)
  vatRate              Decimal                  @default(0) @db.Decimal(5, 2)
  vatAmount            Decimal                  @default(0) @db.Decimal(12, 2)
  totalAmount          Decimal                  @default(0) @db.Decimal(12, 2)
  manualOverride       Boolean                  @default(false)
  manualTotalAmount    Decimal?                 @db.Decimal(12, 2)
  manualOverrideReason String?
  internalNote         String?                  @db.Text
  inputSnapshot        Json?
  resultSnapshot       Json?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  lead                 Lead?                    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer             Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contact              Contact?                 @relation(fields: [contactId], references: [id], onDelete: SetNull)
  priceGroup           PriceGroup?              @relation(fields: [priceGroupId], references: [id], onDelete: SetNull)
  items                PricingCalculationItem[]
  quotes               Quote[]

  @@index([code])
  @@index([leadId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model PricingCalculationItem {
  id                   String             @id @default(cuid())
  pricingCalculationId String
  productId            String?
  variantId            String?
  productNameSnapshot  String?
  variantNameSnapshot  String?
  quantity             Int
  unit                 String             @default("cái")
  baseUnitPrice        Decimal            @default(0) @db.Decimal(12, 2)
  serviceFee           Decimal            @default(0) @db.Decimal(12, 2)
  setupFee             Decimal            @default(0) @db.Decimal(12, 2)
  unitPrice            Decimal            @default(0) @db.Decimal(12, 2)
  discountAmount       Decimal            @default(0) @db.Decimal(12, 2)
  lineSubtotal         Decimal            @default(0) @db.Decimal(12, 2)
  lineTotal            Decimal            @default(0) @db.Decimal(12, 2)
  costEstimate         Decimal?           @db.Decimal(12, 2)
  marginAmount         Decimal?           @db.Decimal(12, 2)
  marginRate           Decimal?           @db.Decimal(8, 4)
  pricingSnapshot      Json?
  manualOverride       Boolean            @default(false)
  manualUnitPrice      Decimal?           @db.Decimal(12, 2)
  manualOverrideReason String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  pricingCalculation   PricingCalculation @relation(fields: [pricingCalculationId], references: [id], onDelete: Cascade)
  product              Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant              ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quoteItems           QuoteItem[]

  @@index([pricingCalculationId])
  @@index([productId])
  @@index([variantId])
}

// ── Sprint 26.2.0 — Quotation Builder MVP ─────────────────────────────────────

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum QuoteSourceType {
  MANUAL
  PRICING_CALCULATION
  LEAD
  CUSTOMER
}

model Quote {
  id                   String              @id @default(cuid())
  quoteNo              String              @unique
  publicToken          String?             @unique
  sourceType           QuoteSourceType     @default(MANUAL)
  pricingCalculationId String?
  leadId               String?
  customerId           String?
  contactId            String?
  priceGroupId         String?
  status               QuoteStatus         @default(DRAFT)
  title                String?
  validUntil           DateTime?
  sentAt               DateTime?
  viewedAt             DateTime?
  acceptedAt           DateTime?
  rejectedAt           DateTime?
  cancelledAt          DateTime?
  subtotal             Decimal             @default(0) @db.Decimal(12, 2)
  serviceTotal         Decimal             @default(0) @db.Decimal(12, 2)
  setupTotal           Decimal             @default(0) @db.Decimal(12, 2)
  discountAmount       Decimal             @default(0) @db.Decimal(12, 2)
  shippingFee          Decimal             @default(0) @db.Decimal(12, 2)
  vatRate              Decimal             @default(0) @db.Decimal(5, 2)
  vatAmount            Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount          Decimal             @default(0) @db.Decimal(12, 2)
  manualOverride       Boolean             @default(false)
  manualTotalAmount    Decimal?            @db.Decimal(12, 2)
  manualOverrideReason String?
  customerNote         String?             @db.Text
  internalNote         String?             @db.Text
  terms                String?             @db.Text
  inputSnapshot        Json?
  resultSnapshot       Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  pricingCalculation   PricingCalculation? @relation(fields: [pricingCalculationId], references: [id], onDelete: SetNull)
  lead                 Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer             Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contact              Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  priceGroup           PriceGroup?         @relation(fields: [priceGroupId], references: [id], onDelete: SetNull)
  items                QuoteItem[]

  @@index([quoteNo])
  @@index([publicToken])
  @@index([status])
  @@index([pricingCalculationId])
  @@index([leadId])
  @@index([customerId])
  @@index([contactId])
  @@index([createdAt])
  @@index([validUntil])
}

model QuoteItem {
  id                       String                  @id @default(cuid())
  quoteId                  String
  pricingCalculationItemId String?
  productId                String?
  variantId                String?
  productNameSnapshot      String?
  variantNameSnapshot      String?
  description              String?
  quantity                 Int
  unit                     String                  @default("cái")
  baseUnitPrice            Decimal                 @default(0) @db.Decimal(12, 2)
  serviceFee               Decimal                 @default(0) @db.Decimal(12, 2)
  setupFee                 Decimal                 @default(0) @db.Decimal(12, 2)
  unitPrice                Decimal                 @default(0) @db.Decimal(12, 2)
  discountAmount           Decimal                 @default(0) @db.Decimal(12, 2)
  lineSubtotal             Decimal                 @default(0) @db.Decimal(12, 2)
  lineTotal                Decimal                 @default(0) @db.Decimal(12, 2)
  costEstimate             Decimal?                @db.Decimal(12, 2)
  marginAmount             Decimal?                @db.Decimal(12, 2)
  marginRate               Decimal?                @db.Decimal(8, 4)
  pricingSnapshot          Json?
  manualOverride           Boolean                 @default(false)
  manualUnitPrice          Decimal?                @db.Decimal(12, 2)
  manualOverrideReason     String?
  sortOrder                Int                     @default(0)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  quote                    Quote                   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  pricingCalculationItem   PricingCalculationItem? @relation(fields: [pricingCalculationItemId], references: [id], onDelete: SetNull)
  product                  Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant                  ProductVariant?         @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([productId])
  @@index([variantId])
  @@index([pricingCalculationItemId])
}

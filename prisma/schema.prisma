generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(CONTENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  parentId       String?
  description    String?
  seoTitle       String?
  seoDescription String?
  imageUrl       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryTree")
  products       Product[]
}

model Product {
  id               String           @id @default(cuid())
  productCode      String?          @unique
  name             String
  slug             String           @unique
  shortDescription String?
  description      String?
  seoTitle         String?
  seoDescription   String?
  gsm              Int?
  material         String?
  fit              String?
  categoryId       String
  status           ProductStatus    @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  category         Category         @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  variants         ProductVariant[]
}

model Color {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  variants  ProductVariant[]
}

model Size {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  variants  ProductVariant[]
}

model ProductVariant {
  id          String      @id @default(cuid())
  productId   String
  colorId     String?
  sizeId      String?
  sku         String      @unique
  dealerPrice Decimal?    @db.Decimal(12, 2)
  vipPrice    Decimal?    @db.Decimal(12, 2)
  stockQty    Int         @default(0)
  stockStatus StockStatus @default(IN_STOCK)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  color       Color?      @relation(fields: [colorId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
  size        Size?       @relation(fields: [sizeId], references: [id])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  imageUrl  String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
}

model Lead {
  id              String     @id @default(cuid())
  name            String
  phone           String
  email           String?
  company         String?
  productInterest String?
  message         String?
  source          String?
  status          LeadStatus @default(NEW)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Dealer {
  id          String       @id @default(cuid())
  companyName String
  taxCode     String?
  phone       String
  email       String
  city        String?
  website     String?
  facebook    String?
  status      DealerStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model DealerLead {
  id             String             @id @default(cuid())
  companyName    String?
  contactName    String
  phone          String
  email          String?
  city           String?
  source         String
  message        String?
  status         DealerLeadStatus   @default(NEW)
  // Attribution
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  referrer       String?
  landingPage    String?
  // CRM pipeline
  pipelineStatus LeadPipelineStatus @default(NEW)
  assignedTo     String?
  estimatedValue Decimal?           @db.Decimal(12, 2)
  contactedAt    DateTime?
  wonAt          DateTime?
  lostAt         DateTime?
  salesNote      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model Post {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  excerpt        String?
  content        String?
  imageUrl       String?
  status         PostStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

enum MediaFolder {
  PRODUCTS
  CATEGORIES
  CLIENTS
  CASE_STUDIES
  BRANDING
}

model MediaAsset {
  id         String      @id @default(cuid())
  filename   String
  url        String
  storageKey String
  mimeType   String
  sizeBytes  Int
  folder     MediaFolder
  altText    String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([folder])
  @@index([filename])
}

model ClientLogoRecord {
  id          String   @id @default(cuid())
  companyName String
  website     String?
  imageUrl    String
  isVisible   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CaseStudyRecord {
  id        String   @id @default(cuid())
  title     String
  category  String
  quantity  String
  timeline  String
  summary   String
  imageUrl  String
  isVisible Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanySettings {
  id             String   @id @default("default")
  brandName      String   @default("ATTD")
  legalName      String   @default("")
  tagline        String   @default("")
  hotlineRaw     String   @default("")
  hotlineDisplay String   @default("")
  zaloPhone      String   @default("")
  zaloUrl        String   @default("")
  email          String   @default("")
  address        String   @default("")
  taxCode        String   @default("")
  workingHours   String   @default("")
  updatedAt      DateTime @updatedAt
}

model TrustMetricsSettings {
  id              String   @id @default("default")
  clientsCount    Int?
  partnerCount    Int?
  provinceCount   Int?
  experienceYears Int?
  sectionTitle    String   @default("Tại sao đại lý và doanh nghiệp chọn ATTD?")
  updatedAt       DateTime @updatedAt
}

model BrandingSettings {
  id                String   @id @default("default")
  headerLogoUrl     String?
  footerLogoUrl     String?
  faviconUrl        String?
  defaultOgImageUrl String?
  companyTagline    String   @default("")
  facebookUrl       String?
  zaloUrl           String?
  youtubeUrl        String?
  tiktokUrl         String?
  linkedinUrl       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum PostStatus {
  PUBLISHED
  DRAFT
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SALES
  CONTENT
  WAREHOUSE
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum LeadStatus {
  NEW
  PROCESSING
  QUOTED
  WON
  LOST
}

enum DealerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DealerLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

enum LeadPipelineStatus {
  NEW
  CONTACTED
  QUOTED
  NEGOTIATING
  WON
  LOST
}

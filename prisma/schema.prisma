generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(CONTENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id             String      @id @default(cuid())
  name           String
  slug           String      @unique
  skuCode        String?
  parentId       String?
  description    String?
  seoTitle       String?
  seoDescription String?
  imageUrl       String?
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  parent         Category?   @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[]  @relation("CategoryTree")
  products       Product[]
  orderItems     OrderItem[]
}

model Product {
  id                        String                           @id @default(cuid())
  productCode               String?                          @unique
  systemCode                String?                          @unique
  name                      String
  slug                      String                           @unique
  shortDescription          String?
  description               String?
  seoTitle                  String?
  seoDescription            String?
  aiSummary                 String?
  gsm                       Int?
  material                  String?
  form                      String?
  fit                       String?
  defaultMoq                Int?
  useCases                  String[]
  targetCustomers           String[]
  supportsPrinting          Boolean                          @default(false)
  supportsEmbroidery        Boolean                          @default(false)
  supportsOem               Boolean                          @default(false)
  tags                      String[]
  featuredImage             String?
  gallery                   String[]                         @default([])
  leadTime                  String?
  metadata                  Json?
  categoryId                String
  status                    ProductStatus                    @default(ACTIVE)
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt
  category                  Category                         @relation(fields: [categoryId], references: [id])
  images                    ProductImage[]
  variants                  ProductVariant[]
  crmProductInterests       CRMProductInterest[]
  productPriceTiers         ProductPriceTier[]
  pricingCalcItems          PricingCalculationItem[]
  quoteItems                QuoteItem[]
  orderItems                OrderItem[]
  materialRequirements      ProductMaterialRequirement[]
  options                   ProductOption[]
  specifications            ProductSpecification[]
  customizationCapabilities ProductCustomizationCapability[]
  attributeAssignments      ProductAttributeAssignment[]

  @@index([categoryId])
  @@index([status])
  @@index([systemCode])
}

model Color {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  hex                  String?
  isActive             Boolean               @default(true)
  sortOrder            Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  variants             ProductVariant[]
  orderItems           OrderItem[]
  orderItemVariants    OrderItemVariant[]
  orderProductionFiles OrderProductionFile[]

  @@index([isActive])
  @@index([sortOrder])
}

model Size {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  variants  ProductVariant[]
}

model ProductVariant {
  id                   String                       @id @default(cuid())
  productId            String
  colorId              String?
  sizeId               String?
  sku                  String                       @unique
  colorName            String?
  colorCode            String?
  sizeName             String?
  dimensions           String?
  capacity             String?
  wholesalePrice       Decimal?                     @db.Decimal(12, 2)
  dealerPrice          Decimal?                     @db.Decimal(12, 2)
  vipPrice             Decimal?                     @db.Decimal(12, 2)
  costPrice            Decimal?                     @db.Decimal(12, 2)
  priceTiers           Json?
  stockQty             Int                          @default(0)
  stockStatus          StockStatus                  @default(IN_STOCK)
  imageUrl             String?
  displayLabel         String?
  moqOverride          Int?
  leadTimeOverride     String?
  materialOverride     String?
  weight               Decimal?                     @db.Decimal(8, 3)
  internalNote         String?
  variantStatus        VariantStatus                @default(ACTIVE)
  metadata             Json?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  color                Color?                       @relation(fields: [colorId], references: [id])
  product              Product                      @relation(fields: [productId], references: [id])
  size                 Size?                        @relation(fields: [sizeId], references: [id])
  crmProductInterests  CRMProductInterest[]
  productPriceTiers    ProductPriceTier[]
  pricingCalcItems     PricingCalculationItem[]
  quoteItems           QuoteItem[]
  orderItems           OrderItem[]
  materialRequirements ProductMaterialRequirement[]
  optionValues         ProductVariantOptionValue[]

  @@index([productId])
  @@index([stockStatus])
  @@index([variantStatus])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  imageUrl  String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
}

model ProductOption {
  id          String               @id @default(cuid())
  productId   String
  attributeId String?
  name        String
  slug        String
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  product     Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   ProductAttribute?    @relation(fields: [attributeId], references: [id], onDelete: SetNull)
  values      ProductOptionValue[]

  @@unique([productId, slug])
  @@index([attributeId])
  @@index([productId, sortOrder])
}

model ProductOptionValue {
  id               String                      @id @default(cuid())
  optionId         String
  attributeValueId String?
  label            String
  valueCode        String?
  imageUrl         String?
  sortOrder        Int                         @default(0)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  option           ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  attributeValue   ProductAttributeValue?      @relation(fields: [attributeValueId], references: [id], onDelete: SetNull)
  variants         ProductVariantOptionValue[]

  @@index([attributeValueId])
  @@index([optionId, sortOrder])
}

model ProductVariantOptionValue {
  variantId     String
  optionValueId String
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

model ProductSpecification {
  id        String   @id @default(cuid())
  productId String
  label     String
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductCustomizationCapability {
  id          String   @id @default(cuid())
  productId   String
  label       String
  description String?
  sortOrder   Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Lead {
  id                  String               @id @default(cuid())
  code                String?              @unique
  fullName            String
  phone               String
  email               String?
  company             String?
  contactName         String?
  companyName         String?
  zalo                String?
  source              LeadSource           @default(WEBSITE)
  sourceDetail        String?
  demand              String?              @db.Text
  status              LeadStatus           @default(NEW)
  priority            LeadPriority         @default(NORMAL)
  message             String?              @db.Text
  note                String?              @db.Text
  followUpAt          DateTime?
  nextFollowUpAt      DateTime?
  estimatedValue      Decimal?             @db.Decimal(12, 2)
  assignedTo          String?
  customerId          String?
  contactId           String?
  convertedAt         DateTime?
  landingPage         String?
  utmSource           String?
  utmMedium           String?
  utmCampaign         String?
  referrer            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contact             Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  notes               LeadNote[]
  activities          CRMActivity[]
  productInterests    CRMProductInterest[]
  pricingCalculations PricingCalculation[]
  quotes              Quote[]

  @@index([code])
  @@index([status])
  @@index([source])
  @@index([priority])
  @@index([phone])
  @@index([email])
  @@index([customerId])
  @@index([createdAt])
  @@index([followUpAt])
  @@index([nextFollowUpAt])
}

model AdministrativeProvince {
  id        String               @id @default(cuid())
  code      String               @unique
  name      String
  sortOrder Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  wards     AdministrativeWard[]
  customers Customer[]

  @@index([code])
  @@index([name])
}

model AdministrativeWard {
  id         String                 @id @default(cuid())
  code       String                 @unique
  provinceId String
  name       String
  sortOrder  Int                    @default(0)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  province   AdministrativeProvince @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  customers  Customer[]

  @@index([provinceId])
  @@index([code])
  @@index([name])
}

model Customer {
  id                   String                  @id @default(cuid())
  code                 String                  @unique
  type                 CustomerType            @default(BUSINESS)
  name                 String
  legalName            String?
  taxCode              String?
  phone                String?
  email                String?
  website              String?
  address              String?
  province             String?
  district             String?
  provinceId           String?
  wardId               String?
  provinceNameSnapshot String?
  wardNameSnapshot     String?
  addressLine1         String?
  addressLine2         String?
  status               CustomerStatus          @default(PROSPECT)
  note                 String?                 @db.Text
  internalNote         String?                 @db.Text
  billingNote          String?                 @db.Text
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  provinceRef          AdministrativeProvince? @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  wardRef              AdministrativeWard?     @relation(fields: [wardId], references: [id], onDelete: SetNull)
  contacts             Contact[]
  leads                Lead[]
  activities           CRMActivity[]
  productInterests     CRMProductInterest[]
  pricingCalculations  PricingCalculation[]
  quotes               Quote[]
  orders               Order[]

  @@index([code])
  @@index([name])
  @@index([phone])
  @@index([email])
  @@index([type])
  @@index([status])
  @@index([provinceId])
  @@index([wardId])
}

model Contact {
  id                  String               @id @default(cuid())
  customerId          String
  fullName            String
  title               String?
  department          String?
  phone               String?
  email               String?
  zalo                String?
  isPrimary           Boolean              @default(false)
  note                String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leads               Lead[]
  activities          CRMActivity[]
  pricingCalculations PricingCalculation[]
  quotes              Quote[]
  orders              Order[]

  @@index([customerId])
}

model CRMActivity {
  id             String          @id @default(cuid())
  leadId         String?
  customerId     String?
  contactId      String?
  type           CRMActivityType @default(NOTE)
  title          String
  content        String?         @db.Text
  outcome        String?
  nextFollowUpAt DateTime?
  createdBy      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact        Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([customerId])
  @@index([createdAt])
}

model CRMProductInterest {
  id                  String          @id @default(cuid())
  leadId              String?
  customerId          String?
  productId           String?
  variantId           String?
  productNameSnapshot String?
  quantity            Int?
  unit                String?         @default("cái")
  requirementNote     String?         @db.Text
  serviceNeeds        Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  lead                Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer            Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product             Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([customerId])
  @@index([productId])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model Dealer {
  id          String       @id @default(cuid())
  companyName String
  taxCode     String?
  phone       String
  email       String
  city        String?
  website     String?
  facebook    String?
  status      DealerStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model DealerLead {
  id             String             @id @default(cuid())
  companyName    String?
  contactName    String
  phone          String
  email          String?
  city           String?
  source         String
  message        String?
  status         DealerLeadStatus   @default(NEW)
  // Attribution
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  referrer       String?
  landingPage    String?
  // CRM pipeline
  pipelineStatus LeadPipelineStatus @default(NEW)
  assignedTo     String?
  estimatedValue Decimal?           @db.Decimal(12, 2)
  contactedAt    DateTime?
  wonAt          DateTime?
  lostAt         DateTime?
  salesNote      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model Post {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  excerpt        String?
  content        String?
  imageUrl       String?
  status         PostStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model BlogCategory {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  description String?
  isVisible   Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  posts       BlogPostCategory[]
}

model BlogPost {
  id               String             @id @default(cuid())
  title            String
  slug             String             @unique
  excerpt          String?
  content          String?            @db.Text
  featuredImageUrl String?
  metaTitle        String?
  metaDescription  String?
  canonicalUrl     String?
  ogImageUrl       String?
  status           BlogPostStatus     @default(DRAFT)
  publishedAt      DateTime?
  faqJson          Json               @default("[]")
  tags             Json               @default("[]")
  aiMetadata       Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  categories       BlogPostCategory[]

  @@index([status])
  @@index([publishedAt])
  @@index([createdAt])
}

model BlogPostCategory {
  postId     String
  categoryId String
  post       BlogPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
}

enum MediaFolder {
  PRODUCTS
  CATEGORIES
  CLIENTS
  CASE_STUDIES
  BRANDING
  BLOG
  GENERAL
}

enum MediaUsageType {
  PRODUCT
  BLOG
  KNOWLEDGE_BASE
  GENERAL
}

enum MediaStorageProvider {
  CLOUDINARY
  CLOUDFLARE_R2
}

model MediaAsset {
  id                       String                    @id @default(cuid())
  filename                 String
  originalName             String?
  url                      String
  thumbnailUrl             String?
  storageKey               String
  storageProvider          MediaStorageProvider      @default(CLOUDINARY)
  publicId                 String?
  mimeType                 String
  format                   String?
  sizeBytes                Int
  width                    Int?
  height                   Int?
  folder                   MediaFolder
  usageType                MediaUsageType            @default(GENERAL)
  altText                  String?
  title                    String?
  tags                     String[]                  @default([])
  uploadedBy               String?
  metadata                 Json?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  quoteItems               QuoteItem[]
  orderItems               OrderItem[]
  salesRepresentatives     SalesRepresentative[]
  orderProductionFiles     OrderProductionFile[]
  orderQcEvidence          OrderQcEvidence[]
  orderDeliveryProofs      OrderDeliveryProof[]
  homepageSourcingPathways HomepageSourcingPathway[] @relation("HomepagePathwayImage")
  homepageOemSettings      HomepageSettings[]        @relation("HomepageOemImage")

  @@index([folder])
  @@index([filename])
  @@index([usageType])
}

model ClientLogoRecord {
  id          String   @id @default(cuid())
  companyName String
  website     String?
  imageUrl    String
  isVisible   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CaseStudyRecord {
  id        String   @id @default(cuid())
  title     String
  category  String
  quantity  String
  timeline  String
  summary   String
  imageUrl  String
  isVisible Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanySettings {
  id             String   @id @default("default")
  brandName      String   @default("ATTD")
  legalName      String   @default("")
  tagline        String   @default("")
  hotlineRaw     String   @default("")
  hotlineDisplay String   @default("")
  zaloPhone      String   @default("")
  zaloUrl        String   @default("")
  email          String   @default("")
  address        String   @default("")
  taxCode        String   @default("")
  workingHours   String   @default("")
  updatedAt      DateTime @updatedAt
}

model TrustMetricsSettings {
  id              String   @id @default("default")
  clientsCount    Int?
  partnerCount    Int?
  provinceCount   Int?
  experienceYears Int?
  sectionTitle    String   @default("Tại sao đại lý và doanh nghiệp chọn ATTD?")
  updatedAt       DateTime @updatedAt
}

model BrandingSettings {
  id                String   @id @default("default")
  headerLogoUrl     String?
  footerLogoUrl     String?
  faviconUrl        String?
  defaultOgImageUrl String?
  companyTagline    String   @default("")
  facebookUrl       String?
  zaloUrl           String?
  youtubeUrl        String?
  tiktokUrl         String?
  linkedinUrl       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model HomepageSettings {
  id                      String                    @id @default("default")
  heroEyebrow             String                    @default("Nền tảng nguồn hàng B2B")
  heroHeading             String                    @default("Nguồn hàng đồng phục & quà tặng cho doanh nghiệp")
  heroDescription         String                    @default("Khám phá sản phẩm sẵn kho, đặt OEM theo yêu cầu và kết nối nguồn hàng phù hợp cho đơn vị của bạn.") @db.Text
  heroPrimaryCtaLabel     String                    @default("Khám phá nguồn hàng")
  heroPrimaryCtaUrl       String                    @default("#home-categories")
  heroSecondaryCtaLabel   String                    @default("Liên hệ báo giá sỉ")
  heroSecondaryCtaUrl     String                    @default("/lien-he")
  proofStripEnabled       Boolean                   @default(true)
  proofStripOrder         Int                       @default(10)
  sourcingPathwaysEnabled Boolean                   @default(true)
  sourcingPathwaysOrder   Int                       @default(20)
  oemEyebrow              String                    @default("OEM & Private Label")
  oemHeading              String                    @default("Phát triển nguồn hàng theo thương hiệu của bạn")
  oemDescription          String                    @default("Từ sản phẩm sẵn có đến phương án phát triển riêng, ATTD hỗ trợ bạn xác định hướng nguồn hàng phù hợp với nhu cầu triển khai.") @db.Text
  oemCtaLabel             String                    @default("Tìm hiểu dịch vụ OEM")
  oemCtaUrl               String                    @default("/oem")
  oemMediaAssetId         String?
  oemImageAlt             String?
  oemEnabled              Boolean                   @default(true)
  oemSectionOrder         Int                       @default(30)
  updatedAt               DateTime                  @updatedAt
  proofItems              HomepageProofItem[]
  sourcingPathways        HomepageSourcingPathway[]
  oemMediaAsset           MediaAsset?               @relation("HomepageOemImage", fields: [oemMediaAssetId], references: [id], onDelete: SetNull)
}

enum HomepageProofIcon {
  PACKAGE
  SETTINGS
  USERS
  TRUCK
}

enum HomepagePathwaySlot {
  STOCK
  OEM
  DEALER
}

model HomepageProofItem {
  id                 String            @id @default(cuid())
  homepageSettingsId String            @default("default")
  itemKey            String
  title              String
  supportingText     String?
  iconKey            HomepageProofIcon
  enabled            Boolean           @default(true)
  sortOrder          Int
  settings           HomepageSettings  @relation(fields: [homepageSettingsId], references: [id], onDelete: Cascade)

  @@unique([homepageSettingsId, itemKey])
  @@index([homepageSettingsId, sortOrder])
}

model HomepageSourcingPathway {
  id                 String              @id @default(cuid())
  homepageSettingsId String              @default("default")
  slot               HomepagePathwaySlot
  microLabel         String
  title              String
  description        String              @db.Text
  ctaLabel           String
  ctaUrl             String
  mediaAssetId       String?
  imageAlt           String?
  enabled            Boolean             @default(true)
  sortOrder          Int
  settings           HomepageSettings    @relation(fields: [homepageSettingsId], references: [id], onDelete: Cascade)
  mediaAsset         MediaAsset?         @relation("HomepagePathwayImage", fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@unique([homepageSettingsId, slot])
  @@index([homepageSettingsId, sortOrder])
}

model LandingPageContent {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  metaTitle         String   @default("")
  metaDescription   String   @default("")
  heroTitle         String   @default("")
  heroDescription   String   @default("")
  seoContent        String   @default("") @db.Text
  faqJson           Json     @default("[]")
  primaryCtaLabel   String   @default("")
  primaryCtaHref    String   @default("")
  secondaryCtaLabel String   @default("")
  secondaryCtaHref  String   @default("")
  isPublished       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum PostStatus {
  PUBLISHED
  DRAFT
}

enum BlogPostStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SALES
  CONTENT
  WAREHOUSE
}

enum ProductStatus {
  ACTIVE
  DRAFT
  INACTIVE
  ARCHIVED
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  PREORDER
}

enum VariantStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum LeadSource {
  CONTACT
  DEALER
  OEM
  SOURCING
  LANDING_PAGE
  WEBSITE
  ZALO
  FACEBOOK
  PHONE
  REFERRAL
  OLD_CUSTOMER
  DIRECT
  PRODUCT_INQUIRY
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTING
  QUALIFIED
  NEED_PRICING
  QUOTED
  NEGOTIATING
  WON
  LOST
  NOT_FIT
}

enum LeadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CustomerType {
  DEALER
  AGENCY
  PRINTER
  EVENT_COMPANY
  BUSINESS
  RETAIL
  SUPPLIER
  OTHER
}

enum CustomerStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  VIP
  BLACKLISTED
}

enum CRMActivityType {
  CALL
  ZALO
  EMAIL
  MEETING
  NOTE
  FOLLOW_UP
  QUOTE_REQUEST
  SAMPLE_REQUEST

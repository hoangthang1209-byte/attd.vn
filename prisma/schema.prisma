/// Manageable content-domain grouping for media assets (DAM Library).
model MediaLibrary {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assets      MediaAsset[]

  @@index([isActive, sortOrder])
}

/// Manageable display-role taxonomy for media assets (DAM Role).
model MediaRole {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assets      MediaAsset[]

  @@index([isActive, sortOrder])
}

/// Project/campaign grouping of media assets. An asset may belong to many collections.
model MediaCollection {
  id             String              @id @default(cuid())
  code           String?             @unique
  name           String
  description    String?             @db.Text
  color          String?
  collectionType MediaCollectionType @default(OTHER)
  sortOrder      Int                 @default(0)
  isActive       Boolean             @default(true)
  isSystem       Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  assets         MediaAssetCollection[]

  @@index([isActive, sortOrder])
  @@index([name])
  @@index([collectionType])
}

model MediaAssetCollection {
  mediaAssetId      String
  mediaCollectionId String
  createdAt         DateTime        @default(now())
  mediaAsset        MediaAsset      @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  mediaCollection   MediaCollection @relation(fields: [mediaCollectionId], references: [id], onDelete: Cascade)

  @@id([mediaAssetId, mediaCollectionId])
  @@index([mediaCollectionId])
}

/// Managed semantic vocabulary for Asset Intelligence metadata.
model MediaVocabularyTerm {
  id          String              @id @default(cuid())
  type        MediaVocabularyType
  code        String?
  name        String
  aliases     String[]            @default([])
  description String?
  sortOrder   Int                 @default(0)
  isActive    Boolean             @default(true)
  isSystem    Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([type, name])
  @@index([type, isActive, sortOrder])
  @@index([code])
}

/// Curated content-ready package of media assets (slots + references; never copies files).
model MediaBundle {
  id             String                 @id @default(cuid())
  code           String?                @unique
  name           String
  description    String?                @db.Text
  status         MediaBundleStatus      @default(DRAFT)
  contentType    MediaBundleContentType @default(GENERAL)
  sortOrder      Int                    @default(0)
  isSystem       Boolean                @default(false)
  isActive       Boolean                @default(true)
  query          String?
  subjectTerms   String[]               @default([])
  industryTerms  String[]               @default([])
  useCaseTerms   String[]               @default([])
  techniqueTerms String[]               @default([])
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  slots          MediaBundleSlot[]
  blogPosts      BlogPost[]
  seoTopics      SeoTopic[]

  @@index([status])
  @@index([contentType, isActive, sortOrder])
  @@index([name])
}

model MediaBundleSlot {
  id            String                 @id @default(cuid())
  mediaBundleId String
  slotType      MediaBundleSlotType
  label         String
  description   String?
  required      Boolean                @default(false)
  minAssets     Int                    @default(1)
  maxAssets     Int?
  sortOrder     Int                    @default(0)
  mediaBundle   MediaBundle            @relation(fields: [mediaBundleId], references: [id], onDelete: Cascade)
  assets        MediaBundleSlotAsset[]

  @@index([mediaBundleId, sortOrder])
  @@index([slotType])
}

model MediaBundleSlotAsset {
  mediaBundleSlotId String
  mediaAssetId      String
  sortOrder         Int             @default(0)
  note              String?
  createdAt         DateTime        @default(now())
  mediaBundleSlot   MediaBundleSlot @relation(fields: [mediaBundleSlotId], references: [id], onDelete: Cascade)
  mediaAsset        MediaAsset      @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@id([mediaBundleSlotId, mediaAssetId])
  @@index([mediaAssetId])
  @@index([mediaBundleSlotId, sortOrder])
}

model MediaAsset {
  id                       String                    @id @default(cuid())
  filename                 String
  originalName             String?
  url                      String
  thumbnailUrl             String?
  storageKey               String
  storageProvider          MediaStorageProvider      @default(CLOUDINARY)
  publicId                 String?
  mimeType                 String
  format                   String?
  sizeBytes                Int
  width                    Int?
  height                   Int?
  /// Legacy compatibility metadata. Prefer libraryId for new Media Library code.
  folder                   MediaFolder
  /// Legacy compatibility metadata. Prefer roleId for new Media Library code.
  usageType                MediaUsageType            @default(GENERAL)
  libraryId                String?
  roleId                   String?
  visibility               MediaVisibility           @default(PUBLIC)
  altText                  String?
  title                    String?
  caption                  String?
  description              String?                   @db.Text
  tags                     String[]                  @default([])
  keywords                 String[]                  @default([])
  aiTags                   String[]                  @default([])
  dominantColor            String?
  orientation              MediaOrientation          @default(UNKNOWN)
  contentLanguage          String?
  contentHash              String?
  perceptualHash           String?
  duplicateOfId            String?
  duplicateStatus          MediaDuplicateStatus      @default(UNIQUE)
  assetType                MediaAssetType            @default(PHOTO)
  subjectTerms             String[]                  @default([])
  materialTerms            String[]                  @default([])
  colorTerms               String[]                  @default([])
  techniqueTerms           String[]                  @default([])
  industryTerms            String[]                  @default([])
  audienceTerms            String[]                  @default([])
  useCaseTerms             String[]                  @default([])
  contentSuitabilities     MediaContentSuitability[] @default([])
  seoScore                 Int                       @default(0)
  metadataCompleteness     Int                       @default(0)
  seoReadinessStatus       MediaSeoReadinessStatus   @default(INCOMPLETE)
  aiProcessingStatus       MediaAiProcessingStatus   @default(NOT_PROCESSED)
  aiProcessedAt            DateTime?
  aiProcessingError        String?                   @db.Text
  aiMetadataVersion        String?
  uploadedBy               String?
  metadata                 Json?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  library                  MediaLibrary?             @relation(fields: [libraryId], references: [id], onDelete: SetNull)
  role                     MediaRole?                @relation(fields: [roleId], references: [id], onDelete: SetNull)
  duplicateOf              MediaAsset?               @relation("MediaAssetDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates               MediaAsset[]              @relation("MediaAssetDuplicates")
  collections              MediaAssetCollection[]
  bundleSlotAssets         MediaBundleSlotAsset[]
  contentMediaAssignments  ContentMediaAssignment[]
  quoteItems               QuoteItem[]
  orderItems               OrderItem[]
  salesRepresentatives     SalesRepresentative[]
  orderProductionFiles     OrderProductionFile[]
  orderQcEvidence          OrderQcEvidence[]
  orderDeliveryProofs      OrderDeliveryProof[]
  manufacturingMedia       ManufacturingMedia[]
  homepageSourcingPathways HomepageSourcingPathway[] @relation("HomepagePathwayImage")
  homepageOemSettings      HomepageSettings[]        @relation("HomepageOemImage")

  @@index([folder])
  @@index([filename])
  @@index([usageType])
  @@index([libraryId])
  @@index([roleId])
  @@index([visibility])
  @@index([orientation])
  @@index([contentHash])
  @@index([perceptualHash])
  @@index([duplicateOfId])
  @@index([duplicateStatus])
  @@index([assetType])
  @@index([seoReadinessStatus])
  @@index([aiProcessingStatus])
  @@index([seoScore])
}

enum ManufacturingAssetStatus {
  DRAFT
  PUBLISHED

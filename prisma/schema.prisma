  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deliveryExecution     OrderDeliveryExecution @relation(fields: [deliveryExecutionId], references: [id], onDelete: Cascade)
  attemptedBy           Employee?              @relation("DeliveryAttemptBy", fields: [attemptedByEmployeeId], references: [id], onDelete: SetNull)
  proofs                OrderDeliveryProof[]

  @@unique([deliveryExecutionId, attemptNumber])
  @@index([deliveryExecutionId])
}

model OrderDeliveryProof {
  id                  String                 @id @default(cuid())
  orderId             String
  deliveryExecutionId String
  deliveryAttemptId   String?
  mediaAssetId        String
  proofType           DeliveryProofType      @default(OTHER)
  title               String?
  note                String?                @db.Text
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  order               Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryExecution   OrderDeliveryExecution @relation(fields: [deliveryExecutionId], references: [id], onDelete: Cascade)
  deliveryAttempt     OrderDeliveryAttempt?  @relation(fields: [deliveryAttemptId], references: [id], onDelete: SetNull)
  mediaAsset          MediaAsset             @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([deliveryExecutionId])
  @@index([deliveryAttemptId])
  @@index([mediaAssetId])
}

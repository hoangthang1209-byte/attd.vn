  reorderPoint        Decimal? @db.Decimal(12, 4)
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  warehouseBalance    MaterialWarehouseBalance?
  stockAdjustments    MaterialStockAdjustment[]
  productRequirements ProductMaterialRequirement[]
  orderItemRequirements OrderItemMaterialRequirement[]
  allocations         OrderMaterialAllocation[]
  purchaseRequestItems PurchaseRequestItem[]

  @@index([materialCode])
  @@index([isActive])
  @@index([materialType])
}

model MaterialWarehouseBalance {
  id                String   @id @default(cuid())
  materialId        String   @unique
  onHandQuantity    Decimal  @default(0) @db.Decimal(12, 4)
  reservedQuantity  Decimal  @default(0) @db.Decimal(12, 4)
  issuedQuantity    Decimal  @default(0) @db.Decimal(12, 4)
  availableQuantity Decimal  @default(0) @db.Decimal(12, 4)
  lastCountedAt     DateTime?
  note              String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  material          Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
}

model MaterialStockAdjustment {
  id                     String                      @id @default(cuid())
  materialId             String
  adjustmentType         MaterialStockAdjustmentType
  quantity               Decimal                     @db.Decimal(12, 4)
  previousOnHandQuantity Decimal                     @db.Decimal(12, 4)
  nextOnHandQuantity     Decimal                     @db.Decimal(12, 4)
  note                   String?                     @db.Text
  referenceOrderId       String?
  createdByEmployeeId    String?
  createdAt              DateTime                    @default(now())
  material               Material                    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  referenceOrder         Order?                      @relation("OrderMaterialStockAdjustments", fields: [referenceOrderId], references: [id], onDelete: SetNull)
  createdByEmployee      Employee?                   @relation(fields: [createdByEmployeeId], references: [id], onDelete: SetNull)

  @@index([materialId])
  @@index([referenceOrderId])
  @@index([createdAt])
}

model OrderMaterialAllocation {
  id               String                        @id @default(cuid())
  orderId          String
  materialId       String
  requiredQuantity Decimal                       @db.Decimal(12, 4)
  reservedQuantity Decimal                       @default(0) @db.Decimal(12, 4)
  issuedQuantity   Decimal                       @default(0) @db.Decimal(12, 4)
  status           OrderMaterialAllocationStatus @default(PENDING)
  note             String?                       @db.Text
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  order            Order                         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  material         Material                      @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([orderId, materialId])
  @@index([orderId])
  @@index([materialId])
  @@index([status])
}

model PurchaseRequest {
  id                    String                @id @default(cuid())
  requestCode           String                @unique
  status                PurchaseRequestStatus @default(DRAFT)
  requestedByEmployeeId String?
  supplierName          String?
  requestedAt           DateTime?
  expectedArrivalAt     DateTime?
  note                  String?               @db.Text
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  requestedByEmployee   Employee?             @relation(fields: [requestedByEmployeeId], references: [id], onDelete: SetNull)
  items                 PurchaseRequestItem[]

  @@index([requestCode])
  @@index([status])
}

model PurchaseRequestItem {
  id                  String          @id @default(cuid())
  purchaseRequestId   String
  materialId          String?
  materialCodeSnapshot String?
  materialNameSnapshot String
  unitSnapshot        String
  requestedQuantity   Decimal         @db.Decimal(12, 4)
  orderedQuantity     Decimal?        @db.Decimal(12, 4)
  receivedQuantity    Decimal         @default(0) @db.Decimal(12, 4)
  linkedOrderId       String?
  note                String?         @db.Text
  sortOrder           Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  purchaseRequest     PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  material            Material?       @relation(fields: [materialId], references: [id], onDelete: SetNull)
  linkedOrder         Order?          @relation(fields: [linkedOrderId], references: [id], onDelete: SetNull)

  @@index([purchaseRequestId])
  @@index([materialId])
  @@index([linkedOrderId])
}
